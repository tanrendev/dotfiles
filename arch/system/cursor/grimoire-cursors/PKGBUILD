pkgname=grimoire-cursors
pkgver=$(find -L shapes svg -printf '%T@\n' | sort -n | tail -n1 | cut -d. -f1)
pkgrel=1
pkgdesc="pixelarticons pixel art cursors"
arch=(any)
makedepends=(hyprcursor librsvg xorg-xcursorgen)
provides=(default-cursors)
conflicts=(default-cursors)
source=(shapes)
sha256sums=(SKIP)

_size=32

_px() {
  awk -v f="$1" -v s="$_size" 'BEGIN { print int(f * s + 0.5) }'
}

build() {
  local theme="$srcdir/$pkgname"
  mkdir -p work/hyprcursors out "$theme/cursors"
  printf '%s\n' "name = $pkgname" "description = $pkgdesc" "version = $pkgver" \
    "cursors_directory = hyprcursors" > work/manifest.hl
  printf '[Icon Theme]\nName=%s\n' "$pkgname" > "$theme/index.theme"

  local shape x y over o svg
  while read -r shape x y over; do
    svg="$startdir/svg/$shape.svg"
    mkdir "work/hyprcursors/$shape"
    cp "$svg" "work/hyprcursors/$shape/"
    {
      printf '%s\n' "resize_algorithm = none" "hotspot_x = $x" "hotspot_y = $y"
      for o in $over; do
        printf 'define_override = %s\n' "$o"
      done
      printf 'define_size = 0, %s.svg\n' "$shape"
    } > "work/hyprcursors/$shape/meta.hl"
    rsvg-convert -w "$_size" -h "$_size" "$svg" -o "$shape.png"
    printf '%s %s %s %s.png\n' "$_size" "$(_px "$x")" "$(_px "$y")" "$shape" > "$shape.cfg"
    xcursorgen "$shape.cfg" "$theme/cursors/$shape"
    for o in $over; do
      ln -s "$shape" "$theme/cursors/$o"
    done
  done < shapes

  hyprcursor-util --create work --output out
  cp -r out/*/. "$theme/"
}

package() {
  install -d "$pkgdir/usr/share/icons/default"
  cp -r "$pkgname" "$pkgdir/usr/share/icons/"
  printf '[Icon Theme]\nInherits=%s\n' "$pkgname" > "$pkgdir/usr/share/icons/default/index.theme"
}
