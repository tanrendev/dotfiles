    {
      "name": "String escapes",
      "scope": "constant.character.escape, constant.other.placeholder",
      "settings": {
        "foreground": "{{colors.terminal_normal_cyan.light.hex}}"
      }
    },
    {
      "name": "Regular expressions",
      "scope": "string.regexp",
      "settings": {
        "foreground": "{{colors.terminal_normal_cyan.light.hex}}"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": "constant.numeric, constant.language, constant.other, support.constant",
      "settings": {
        "foreground": "{{colors.terminal_normal_magenta.light.hex}}"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": "keyword, keyword.control, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "{{colors.primary.light.hex}}"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "{{colors.on_surface_variant.light.hex}}"
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function, support.function, meta.function-call.generic, variable.function",
      "settings": {
        "foreground": "{{colors.terminal_normal_blue.light.hex}}"
      }
    },
    {
      "name": "Types and classes",
      "scope": "entity.name.type, entity.name.class, entity.name.namespace, entity.other.inherited-class, support.class, support.type",
      "settings": {
        "foreground": "{{colors.tertiary.light.hex}}"
      }
    },
    {
      "name": "Variables",
      "scope": "variable, meta.definition.variable.name, support.variable",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}"
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variables",
      "scope": "variable.language",
      "settings": {
        "foreground": "{{colors.terminal_normal_red.light.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object properties",
      "scope": "variable.other.property, variable.other.object.property, meta.object-literal.key",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}"
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "{{colors.terminal_normal_red.light.hex}}"
      }
    },
    {
      "name": "YAML keys",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "{{colors.terminal_normal_blue.light.hex}}"
      }
    },
    {
      "name": "Attributes",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "{{colors.terminal_normal_yellow.light.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator, meta.function.decorator.python, support.token.decorator.python",
      "settings": {
        "foreground": "{{colors.terminal_normal_yellow.light.hex}}"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation.separator, punctuation.terminator, meta.brace",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid, invalid.illegal, invalid.deprecated",
      "settings": {
        "foreground": "{{colors.error.light.hex}}"
      }
    },
    {
      "name": "JSON property names",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "{{colors.terminal_normal_blue.light.hex}}"
      }
    },
    {
      "name": "CSS property names",
      "scope": "support.type.property-name.css, support.type.vendored.property-name.css",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}"
      }
    },
    {
      "name": "CSS property values",
      "scope": "support.constant.property-value",
      "settings": {
        "foreground": "{{colors.terminal_normal_magenta.light.hex}}"
      }
    },
    {
      "name": "Markup headings",
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "{{colors.primary.light.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "{{colors.on_surface.light.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup quotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "{{colors.outline.light.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inline code",
      "scope": "markup.inline.raw, markup.fenced_code.block",
      "settings": {
        "foreground": "{{colors.terminal_normal_yellow.light.hex}}"
      }
    },
    {
      "name": "Markup links",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "{{colors.terminal_normal_blue.light.hex}}"
      }
    },
    {
      "name": "Markup inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "{{colors.terminal_normal_green.light.hex}}"
      }
    },
    {
      "name": "Markup deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "{{colors.error.light.hex}}"
      }
    },
    {
      "name": "Markup changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "{{colors.terminal_normal_blue.light.hex}}"
      }
    }
  ]
}
